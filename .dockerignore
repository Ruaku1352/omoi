# Backend(Cloud Run) Deploy UnitのDocker Build Context用。
# Build Contextはリポジトリルート（docs/deploy.md参照）。

# Frontend Deploy Unitはbackendイメージに含めない
frontend/
node_modules/

# Backendのローカル生成物・仮想環境
backend/.venv/
backend/.dev-assets/
**/__pycache__/
**/*.py[cod]
backend/.pytest_cache/
backend/.ruff_cache/
**/*.egg-info/

# Secret — 絶対にBuild Contextへ入れない
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
*.pem
*-service-account*.json
credentials.json

# VCS / Editor / OS
.git/
.gitignore
.gitattributes
.vscode/
.idea/
.DS_Store
Thumbs.db

# 実行時に不要（イメージサイズ削減）
docs/
skills/
scripts/*
!scripts/flat_photo_parts_poc.py
README.md
AGENTS.md
CLAUDE.md
backend/README.md
backend/ai/README.md
frontend/README.md

# その他
*.log
.firebase/
firebase-debug.log
/tmp/
