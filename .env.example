# Key名のみを共有する。Secret値をこのファイルへ書かないこと。
# 実際の値は各自の .env（Commit禁止）または Deploy先の Secret / 環境変数へ設定する。

# ---- Frontend (frontend/.env) ----
# 公開可能な設定のみ。VITE_ Prefix の値は Browser から見える。
VITE_API_BASE_URL=
# 開発専用Flag（担当裁量）
# VITE_USE_MOCK=
# 【PoC後FIX】の暫定値の上書き。未設定なら frontend/src/config/artworkEditing.ts の既定値。
# VITE_MIN_SCALE=
# VITE_MAX_SCALE=
# VITE_PREVIEW_DEPTH_STEP=

# ---- Backend (backend/.env) ----
# Secret。Repositoryへ絶対にCommitしない。
GEMINI_API_KEY=
# 意味理解・象徴要素選定・構成用。最終Model IDは未FIXで、PoCで検証した値を設定する。
GEMINI_MODEL=
# EfficientSAM-Ti ONNX の完全Model path。Runtimeではdownloadしない。
EFFICIENTSAM_MODEL_PATH=
# P0 FIXのSegmentation Backend（現状は efficient_sam_onnx のみ）。
SEGMENTATION_BACKEND=efficient_sam_onnx
# CORS許可Origin（カンマ区切り）。Productionでは必要最小限に限定する。
CORS_ORIGINS=
# local / deployed
APP_ENV=
# true にすると実Geminiを呼ばず共通Mock相当を返す。本番の隠れFallbackではない。
MOCK_AI=

# ---- Backend / 任意（未設定なら backend/app/config.py の既定値）----
# 共通Contract（contracts/）の場所。Deploy時にCopy先が変わる場合のみ設定する。
# CONTRACTS_DIR=
# Upload制限【PoC後FIX】。代表ケースは写真5枚だが固定5枚の契約ではない。
# MAX_PHOTOS=
# MAX_PHOTO_BYTES=
# MAX_TOTAL_UPLOAD_BYTES=
# 以下はAI PoC後に調整する設定。未設定時はbackend/app/config.pyの既定値を使う。
# SEGMENTATION_MAX_RETRIES=
# CANDIDATE_COUNT=
# TARGET_LAYER_MIN=
# TARGET_LAYER_MAX=
# MVP production既定値は2L判Landscape (178 / 127)。非MVP検証時のみ差し替える。
# ARTWORK_CANVAS_ASPECT_RATIO=
# GEMINI_ANALYSIS_MAX_SIDE=
# GEMINI_REQUEST_TIMEOUT_MS=
# SEGMENTATION_MAX_SIDE=
# LAYER_PADDING_PX=
# LAYOUT_MIN_SCALE=
# LAYOUT_MAX_SCALE=
# Asset Binary Storage方式は【未決定】。暫定のLocal書き出し先と静的配信Prefix。
# ASSET_DIR=
# ASSET_MOUNT_PATH=
# 外部Storageへ移したときのURL Prefix上書き。未設定ならRequestのOriginを使う。
# ASSET_PUBLIC_BASE_URL=
