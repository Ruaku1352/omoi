# Key名のみを共有する。Secret値をこのファイルへ書かないこと。
# 実際の値は各自の .env（Commit禁止）または Deploy先の Secret / 環境変数へ設定する。

# ---- Frontend (frontend/.env) ----
# 公開可能な設定のみ。VITE_ Prefix の値は Browser から見える。
VITE_API_BASE_URL=
# 開発専用Flag（担当裁量）
# VITE_USE_MOCK=

# ---- Backend (backend/.env) ----
# Secret。Repositoryへ絶対にCommitしない。
GEMINI_API_KEY=
# 意味理解・象徴要素選定・構成用。初期候補 gemini-3.7-flash【PoC後FIX】
GEMINI_MODEL=
# Segmentation用。初期候補 gemini-2.5-flash【PoC後FIX】
GEMINI_SEGMENTATION_MODEL=
# CORS許可Origin（カンマ区切り）。Productionでは必要最小限に限定する。
CORS_ORIGINS=
# local / deployed
APP_ENV=
# true にすると実Geminiを呼ばず共通Mock相当を返す。本番の隠れFallbackではない。
MOCK_AI=
